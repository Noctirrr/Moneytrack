rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an admin (Strictly 0708saipin@gmail.com only)
    function isAdmin() {
      return isAuthenticated() && 
        ('email' in request.auth.token) && 
        request.auth.token.email.lower() == '0708saipin@gmail.com';
    }
    
    // System public configuration, announcements, and global default categories
    match /system/{document=**} {
      // Public or all users can read system announcements and global categories
      allow read: if true;
      // Only authorized admins can modify system backoffice settings
      allow write: if isAdmin();
    }
    
    // System admin accounts registry (public read so unauthenticated listeners never error)
    match /system_admins/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // User accounts and private data
    match /users/{userId} {
      // Users can get their own profile, and admin can list/get all user profiles
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // User subcollections (transactions, categories, settings)
      match /{allChildren=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
